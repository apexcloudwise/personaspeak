<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PersonaSpeak Light -->
    <style name="PersonaSpeakLightAnyKeyboardTheme">
        <item name="android:background">@drawable/ps_light_keyboard_background</item>
        <item name="keyBackground">@drawable/ps_light_key</item>

        <item name="keyTextSize">@dimen/ps_key_text_size</item>
        <item name="keyTextStyle">normal</item>
        <item name="keyTextColor">#FF1B1F27</item>
        <item name="hintTextColor">#FF8A93A2</item>
        <item name="labelTextSize">@dimen/ps_key_label_text_size</item>
        <item name="hintTextSize">0px</item>

        <item name="shadowColor">#00000000</item>
        <item name="shadowRadius">0px</item>
        <item name="shadowOffsetX">0px</item>
        <item name="shadowOffsetY">0px</item>
        <item name="backgroundDimAmount">0</item>

        <!-- key preview (feedback) -->
        <item name="keyPreviewBackground">@drawable/ps_light_key_preview_background</item>
        <item name="keyPreviewTextColor">#FF1B1F27</item>
        <item name="keyPreviewTextSize">28sp</item>
        <item name="keyPreviewLabelTextSize">18sp</item>

        <!-- suggestion strip -->
        <item name="suggestionBackgroundImage">@drawable/ps_light_suggestions_background</item>
        <item name="suggestionStripHeight">@dimen/ps_suggestion_strip_height</item>
        <item name="suggestionNormalTextColor">#FF1B1F27</item>
        <item name="suggestionRecommendedTextColor">#FF2E5BFF</item>
        <item name="suggestionOthersTextColor">#FF6B7482</item>
        <item name="keyboardNameTextColor">#66000000</item>

        <!-- key heights -->
        <item name="keyNormalHeight">@dimen/ps_key_height</item>
        <item name="keySmallHeight">@dimen/ps_key_half_height</item>
        <item name="keyLargeHeight">@dimen/ps_key_tall_height</item>

        <!-- key gaps -->
        <item name="keyHorizontalGap">@dimen/ps_key_horizontal_gap</item>
        <item name="keyVerticalGap">@dimen/ps_key_vertical_gap</item>
    </style>

    <style name="PersonaSpeakLightPopupTheme" parent="@style/PersonaSpeakLightAnyKeyboardTheme">
        <item name="android:background">@drawable/ps_light_popup_background</item>
        <item name="keyBackground">@drawable/ps_light_key_popup</item>
        <!-- no key preview inside popups -->
        <item name="keyPreviewTextSize">0px</item>
    </style>

    <!-- PersonaSpeak Dark -->
    <style name="PersonaSpeakDarkAnyKeyboardTheme">
        <item name="android:background">@drawable/ps_dark_keyboard_background</item>
        <item name="keyBackground">@drawable/ps_dark_key</item>

        <item name="keyTextSize">@dimen/ps_key_text_size</item>
        <item name="keyTextStyle">normal</item>
        <item name="keyTextColor">#FFE7EAF0</item>
        <item name="hintTextColor">#FF77808F</item>
        <item name="labelTextSize">@dimen/ps_key_label_text_size</item>
        <item name="hintTextSize">0px</item>

        <item name="shadowColor">#00000000</item>
        <item name="shadowRadius">0px</item>
        <item name="shadowOffsetX">0px</item>
        <item name="shadowOffsetY">0px</item>
        <item name="backgroundDimAmount">0</item>

        <!-- key preview (feedback) -->
        <item name="keyPreviewBackground">@drawable/ps_dark_key_preview_background</item>
        <item name="keyPreviewTextColor">#FFE7EAF0</item>
        <item name="keyPreviewTextSize">28sp</item>
        <item name="keyPreviewLabelTextSize">18sp</item>

        <!-- suggestion strip -->
        <item name="suggestionBackgroundImage">@drawable/ps_dark_suggestions_background</item>
        <item name="suggestionStripHeight">@dimen/ps_suggestion_strip_height</item>
        <item name="suggestionNormalTextColor">#FFE7EAF0</item>
        <item name="suggestionRecommendedTextColor">#FF7C9BFF</item>
        <item name="suggestionOthersTextColor">#FF9AA3B2</item>
        <item name="keyboardNameTextColor">#66FFFFFF</item>

        <!-- key heights -->
        <item name="keyNormalHeight">@dimen/ps_key_height</item>
        <item name="keySmallHeight">@dimen/ps_key_half_height</item>
        <item name="keyLargeHeight">@dimen/ps_key_tall_height</item>

        <!-- key gaps -->
        <item name="keyHorizontalGap">@dimen/ps_key_horizontal_gap</item>
        <item name="keyVerticalGap">@dimen/ps_key_vertical_gap</item>
    </style>

    <style name="PersonaSpeakDarkPopupTheme" parent="@style/PersonaSpeakDarkAnyKeyboardTheme">
        <item name="android:background">@drawable/ps_dark_popup_background</item>
        <item name="keyBackground">@drawable/ps_dark_key_popup</item>
        <!-- no key preview inside popups -->
        <item name="keyPreviewTextSize">0px</item>
    </style>
</resources>
