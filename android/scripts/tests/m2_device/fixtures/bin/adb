#!/usr/bin/env python3
"""Fake adb for device-free M2 harness qualification tests.

Honest about the 2026-08-19 ruling (#79): uiautomator cannot observe an
IME window on API 34, so hierarchies here contain ZERO keyboard-package
nodes — host-app nodes only. Keyboard facts flow exclusively through the
channels a real device actually offers: `ime enable`/`ime set` state,
`dumpsys input_method`, `dumpsys window windows`, and the host editor
node's text attribute. Every knob is opt-in per run.
"""
import os
import struct
import sys
import time
import zlib

log_path = os.environ.get("MOCK_COMMANDS_LOG")
if log_path:
    with open(log_path, "a") as f:
        f.write(f"adb: {' '.join(sys.argv[1:])}\n")

_uid = os.getuid()
STATE_FILE = os.environ.get("FAKE_ADB_STATE", f"/tmp/fake_adb_edittext.{_uid}.state")
KB_FILE = os.environ.get("FAKE_ADB_KEYBOARD", f"/tmp/fake_adb_keyboard.{_uid}.state")
FOCUS_FILE = os.environ.get("FAKE_ADB_FOCUS", f"/tmp/fake_adb_focus.{_uid}.state")
SCREEN_FILE = os.environ.get("FAKE_ADB_SCREEN", f"/tmp/fake_adb_screen.{_uid}.state")
IME_FILE = os.environ.get("FAKE_ADB_IME", f"/tmp/fake_adb_ime.{_uid}.state")
CAND_SRC_FILE = os.environ.get("FAKE_ADB_CANDIDATE_SOURCE", f"/tmp/fake_adb_cand_src.{_uid}.state")
CANDIDATE = os.environ.get("FAKE_ADB_REPHRASING", "")
SOURCE = "Tea at six."
STALE = "Tea at seven."

COMPONENT = "biz.pixelperfectstudios.personaspeak/com.menny.android.anysoftkeyboard.SoftKeyboard"
KEYBOARD_PACKAGE = "biz.pixelperfectstudios.personaspeak"
EDITOR_RES_ID = "com.google.android.settings.intelligence:id/open_search_view_edit_text"
EDITOR_HINT = "Search settings"
SEARCH_BAR_RES_ID = "com.android.settings:id/search_action_bar"

# Real-layout geometry (2026-08-19 debug session), mirrored from the
# harness pins so the fake only answers taps the real keyboard has.
SEARCH_BAR_BOUNDS = (42, 591, 1038, 728)
EDITOR_BOUNDS = (126, 149, 1080, 275)
KEY_COORDS = {
    "t": (486, 1794), "e": (270, 1794), "a": (108, 1932),
    "s": (216, 1932), "i": (810, 1794), "x": (215, 2072),
    "v": (431, 2072), "n": (647, 2072),
    " ": (566, 2210), ".": (755, 2210),
}
REWRITE_TAP = (116, 1452)
CANCEL_TAP = (180, 1452)
APPLY_TAP = (105, 1452)
DISMISS_TAP = (328, 1452)
TAP_SLOP = 54  # half a 108px key cell
COMPACT_TOP = 1378
EXPANDED_TOP = 1260


def _read(path):
    try:
        with open(path) as f:
            return f.read().rstrip('\n')
    except FileNotFoundError:
        return ""


def _write(path, s):
    with open(path, "w") as f:
        f.write(s)


def _reset_to_pristine():
    """`emu snapshot load` reverts the whole device: screen, editor,
    keyboard panel, focus, and the IME enablement/selection mutation."""
    _write(STATE_FILE, "")
    _write(KB_FILE, "")
    _write(FOCUS_FILE, "")
    _write(SCREEN_FILE, "")
    _write(IME_FILE, "")
    _write(CAND_SRC_FILE, "")


def _write_png(path):
    sig = b'\x89PNG\r\n\x1a\n'
    ihdr_data = struct.pack('>IIBBBBB', 1, 1, 8, 2, 0, 0, 0)
    ihdr = (
        struct.pack('>I', 13) + b'IHDR' + ihdr_data
        + struct.pack('>I', zlib.crc32(b'IHDR' + ihdr_data) & 0xFFFFFFFF)
    )
    comp = zlib.compress(b'\x00\xff\x00\x00')
    idat = (
        struct.pack('>I', len(comp)) + b'IDAT' + comp
        + struct.pack('>I', zlib.crc32(b'IDAT' + comp) & 0xFFFFFFFF)
    )
    iend = (
        struct.pack('>I', 0) + b'IEND'
        + struct.pack('>I', zlib.crc32(b'IEND') & 0xFFFFFFFF)
    )
    with open(path, 'wb') as f:
        f.write(sig + ihdr + idat + iend)


def _write_mp4(path):
    payload = b'isom' + b'\x00\x00\x00\x00' + b'isom'
    ftyp = struct.pack('>I', 8 + len(payload)) + b'ftyp' + payload
    mdat = struct.pack('>I', 12) + b'mdat' + b'\x00\x00\x00\x00'
    with open(path, 'wb') as f:
        f.write(ftyp + mdat)


def _render_hierarchy(duplicate_editor=False):
    """Host-app nodes only. The IME window — keys, panel, candidate —
    is structurally invisible to uiautomator on API 34 and must never
    appear here (issue #79)."""
    if _read(SCREEN_FILE) == "search":
        text = _read(STATE_FILE)
        shown = text if text else EDITOR_HINT
        focused = "true" if _read(FOCUS_FILE) == "1" else "false"
        ex1, ey1, ex2, ey2 = EDITOR_BOUNDS
        editor = (
            f'<node index="0" text="{shown}" focused="{focused}" '
            f'resource-id="{EDITOR_RES_ID}" '
            f'class="android.widget.EditText" package="com.google.android.settings.intelligence" '
            f'bounds="[{ex1},{ey1}][{ex2},{ey2}]"/>'
        )
        if duplicate_editor:
            editor = editor + editor
        return (
            '<hierarchy rotation="0">'
            '<node index="0" text="" resource-id="com.google.android.settings.intelligence:id/open_search_view_status_bar_spacer" '
            'class="android.view.View" package="com.google.android.settings.intelligence" bounds="[0,0][1080,128]"/>'
            f'{editor}'
            '<node index="2" text="" resource-id="com.google.android.settings.intelligence:id/open_search_view_divider" '
            'class="android.view.View" package="com.google.android.settings.intelligence" bounds="[0,275][1080,301]"/>'
            '</hierarchy>'
        )
    bx1, by1, bx2, by2 = SEARCH_BAR_BOUNDS
    return (
        '<hierarchy rotation="0">'
        f'<node index="0" text="" resource-id="{SEARCH_BAR_RES_ID}" '
        f'class="android.view.ViewGroup" package="com.android.settings" '
        f'clickable="true" focusable="true" focused="false" bounds="[{bx1},{by1}][{bx2},{by2}]"/>'
        '<node index="1" text="Search settings" resource-id="com.android.settings:id/search_action_bar_title" '
        'class="android.widget.TextView" package="com.android.settings" bounds="[200,624][553,695]"/>'
        '</hierarchy>'
    )


def _write_hierarchy(path, duplicate_res_id="", malformed=False, symlinked=False):
    if malformed:
        with open(path, "wb") as f:
            f.write(b"<hierarchy truncated-not-xml")
        return
    if symlinked:
        # Hostile tool: valid hierarchy bytes outside the artifacts dir,
        # with the artifact itself a symlink pointing at them.
        target = os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(path))),
            "hierarchy_source.xml")
        with open(target, "w") as f:
            f.write(_render_hierarchy())
        if os.path.lexists(path):
            os.remove(path)
        os.symlink(target, path)
        return
    duplicate = bool(duplicate_res_id) and duplicate_res_id in EDITOR_RES_ID
    with open(path, "w") as f:
        f.write(_render_hierarchy(duplicate_editor=duplicate))


def _ime_bound():
    """The IME binds only when enabled, selected, and an editor holds
    focus — the state machine Android actually enforces."""
    return (_read(IME_FILE) == "set"
            and _read(SCREEN_FILE) == "search"
            and _read(FOCUS_FILE) == "1")


def _panel_expanded():
    # Loading keeps the compact row; Review (any outcome) grows upward.
    return _read(KB_FILE) in ("REVIEW", "APPLIED", "STALE")


def _advance_loading():
    # The fixture provider's 400ms latency: any dumpsys query arrives
    # after the host's settle sleep, so loading has completed.
    if _read(KB_FILE) == "LOADING":
        _write(KB_FILE, "REVIEW")


def _dumpsys_input_method():
    if os.environ.get("FAKE_ADB_IME_UNBOUND") or not _ime_bound():
        return (
            "  mCurMethodId=com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME\n"
            "  mHaveConnection=false\n"
            "  mBoundToMethod=false\n"
            "  mVisibleBound=false\n"
        )
    _advance_loading()
    return (
        f"  mCurMethodId={COMPONENT}\n"
        "  mCurClient=ClientState{mUid=1000}\n"
        "  mHaveConnection=true\n"
        "  mBoundToMethod=true\n"
        "  mCurMethod=MethodState{mToken=...}\n"
        "  mSystemReady=true\n"
        "  mVisibleBound=true\n"
    )


def _dumpsys_window():
    if os.environ.get("FAKE_ADB_IME_WINDOW_MISSING") or not _ime_bound():
        return (
            "  Window #1 Window{abc123 u0 com.android.settings/com.android.settings.Settings}:\n"
            "    mOwnerUid=1000 package=com.android.settings\n"
            "    mViewVisibility=0x0\n"
            "    isReadyForDisplay()=true\n"
            "    mFrame=[0,0][1080,2400]\n"
            "    HAS_DRAWN\n"
        )
    _advance_loading()
    if _panel_expanded() and not os.environ.get("FAKE_ADB_WINDOW_NEVER_EXPANDS"):
        top = EXPANDED_TOP
    else:
        top = COMPACT_TOP
    return (
        "  Window #1 Window{abc123 u0 com.android.settings/com.android.settings.Settings}:\n"
        "    mOwnerUid=1000 package=com.android.settings\n"
        "    mViewVisibility=0x0\n"
        "    isReadyForDisplay()=true\n"
        "    mFrame=[0,0][1080,2400]\n"
        "    HAS_DRAWN\n"
        "  Window #4 Window{d4e5f6 u0 InputMethod}:\n"
        f"    mOwnerUid=10198 mShowToOwnerOnly=true package={KEYBOARD_PACKAGE} userId=0\n"
        "    mAttrs=WM.LayoutParams{(0,0)(fillxfh) gr=#11 sim=#32 ty=INPUT_METHOD fmt=-3}\n"
        "    mViewVisibility=0x0 mHaveFrame=true\n"
        "    isReadyForDisplay()=true\n"
        f"    mFrame=[0,{top}][1080,2400]\n"
        "    HAS_DRAWN\n"
    )


def _run_tap(x, y):
    if _read(SCREEN_FILE) != "search":
        bx1, by1, bx2, by2 = SEARCH_BAR_BOUNDS
        if bx1 <= x <= bx2 and by1 <= y <= by2:
            # Enter the search screen: fresh, empty, focused editor.
            _write(SCREEN_FILE, "search")
            _write(STATE_FILE, "")
            _write(KB_FILE, "")
            _write(FOCUS_FILE, "1")
        return
    ex1, ey1, ex2, ey2 = EDITOR_BOUNDS
    if ex1 <= x <= ex2 and ey1 <= y <= ey2:
        _write(FOCUS_FILE, "1")
        return
    # Panel row controls (IME-owned; verified only through behavior).
    # Rewrite and Use this share the row's left slot — which one answers
    # depends on the panel state, exactly like the real row.
    def _near(cx, cy):
        return abs(x - cx) <= TAP_SLOP and abs(y - cy) <= TAP_SLOP
    panel = _read(KB_FILE)
    if _near(*REWRITE_TAP) or _near(*APPLY_TAP):
        if panel == "":
            if _read(STATE_FILE):
                _write(KB_FILE, "LOADING")
                _write(CAND_SRC_FILE, _read(STATE_FILE))
        elif panel == "REVIEW":
            if _read(STATE_FILE) == _read(CAND_SRC_FILE):
                # Fresh candidate: exactly one mutation.
                _write(STATE_FILE, CANDIDATE)
                _write(KB_FILE, "APPLIED")
            else:
                # Stale: zero mutations, candidate retained in Review.
                _write(KB_FILE, "STALE")
        return
    if _near(*CANCEL_TAP):
        if panel == "LOADING":
            _write(KB_FILE, "")
        return
    if _near(*DISMISS_TAP):
        if panel == "REVIEW":
            _write(KB_FILE, "")
        return
    # Key taps: the only insertion path, exactly the pinned geometry.
    shift = 60 if os.environ.get("FAKE_ADB_KEY_LAYOUT_SHIFTED") else 0
    for ch, (kx, ky) in KEY_COORDS.items():
        kx, ky = kx + shift, ky + shift
        if abs(x - kx) <= TAP_SLOP and abs(y - ky) <= TAP_SLOP:
            if _read(FOCUS_FILE) == "1":
                cur = _read(STATE_FILE)
                if not cur and ch.isalpha():
                    cur = ch.upper()
                else:
                    cur += ch
                _write(STATE_FILE, cur)
            return


def _run_keyevent(code):
    if code == "4":  # BACK: the search screen closes, session ends.
        if _read(SCREEN_FILE) == "search":
            _write(SCREEN_FILE, "")
            _write(STATE_FILE, "")
            _write(KB_FILE, "")
            _write(FOCUS_FILE, "")
            _write(CAND_SRC_FILE, "")
        return
    if code == "67" and _read(SCREEN_FILE) == "search":  # DEL
        if _read(FOCUS_FILE) == "1":
            cur = _read(STATE_FILE)
            _write(STATE_FILE, cur[:-1])


def _run_shell_segment(cmd):
    if "ime enable" in cmd:
        if os.environ.get("FAKE_ADB_IME_ENABLE_FAIL"):
            sys.stderr.write("Error: ime enable failed\n")
            sys.exit(1)
        _write(IME_FILE, "enabled")
        return
    if "ime set" in cmd:
        if os.environ.get("FAKE_ADB_IME_SET_FAIL"):
            sys.stderr.write("Error: ime set failed\n")
            sys.exit(1)
        _write(IME_FILE, "set")
        return
    if "dumpsys input_method" in cmd:
        print(_dumpsys_input_method(), end="")
        return
    if "dumpsys window" in cmd:
        print(_dumpsys_window(), end="")
        return
    if "input tap" in cmd:
        parts = cmd.split()
        idx = parts.index("tap")
        _run_tap(int(parts[idx + 1]), int(parts[idx + 2]))
        return
    if "input keyevent" in cmd:
        parts = cmd.split()
        idx = parts.index("keyevent")
        _run_keyevent(parts[idx + 1])
        return
    if "am start" in cmd:
        _write(SCREEN_FILE, "")
        return


cmd = " ".join(sys.argv[1:])

# --- Acceptance-matrix knobs (issue #62): scripted failure injection. ---

_fail_knob = os.environ.get("FAKE_ADB_FAIL", "")
if "=" in _fail_knob:
    _pat, _, _spec = _fail_knob.partition("=")
    if _pat and _pat in cmd:
        _rc_s, _, _msg = _spec.partition(":")
        if _msg:
            sys.stderr.write(_msg + "\n")
        sys.exit(int(_rc_s))

_sleep_knob = os.environ.get("FAKE_ADB_SLEEP_ON", "")
if _sleep_knob and _sleep_knob in cmd:
    time.sleep(float(os.environ.get("FAKE_ADB_SLEEP_SECS", "45")))

_garbage_knob = os.environ.get("FAKE_ADB_GARBAGE", "")
if _garbage_knob and _garbage_knob in cmd:
    print("<unparseable-garbage-output>")
    sys.exit(0)

_prop_knob = os.environ.get("FAKE_ADB_PROP", "")
if _prop_knob and "=" in _prop_knob and "getprop" in cmd:
    _prop, _, _val = _prop_knob.partition("=")
    if _prop and _prop in cmd:
        print(_val)
        sys.exit(0)

_wm_flag = os.environ.get("FAKE_ADB_WM_FLAG", "")
_wm_drift = os.environ.get("FAKE_ADB_POST_RESTORE_WM", "")
if (_wm_flag and _wm_drift and "wm size" in cmd
        and os.path.isfile(_wm_flag)):
    # Post-restore drift: the snapshot "load" reports success, then the
    # device answers every later identity query with the wrong size.
    print(f"Physical size: {_wm_drift}")
    sys.exit(0)

if "getprop sys.boot_completed" in cmd:
    print("1")
elif "getprop ro.build.fingerprint" in cmd:
    print("google/sdk_gphone64_arm64/emu64a:14/UE1A.230829.050/12077443:userdebug/dev-keys")
elif "getprop ro.build.version.sdk" in cmd:
    print("34")
elif "getprop ro.product.cpu.abi" in cmd:
    print("arm64-v8a")
elif "getprop qemu.sf.lcd_density" in cmd:
    print("420")
elif "settings get global window_animation_scale" in cmd:
    print("1.0")
elif "settings get global transition_animation_scale" in cmd:
    print("1.0")
elif "settings get global animator_duration_scale" in cmd:
    print("null")
elif "settings get secure enabled_input_methods" in cmd:
    if _read(IME_FILE):
        print("com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME:"
              "com.google.android.tts/com.google.android.apps.speech.tts.googletts.settings.asr.voiceime.VoiceInputMethodService:"
              + COMPONENT)
    else:
        print("com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME:"
              "com.google.android.tts/com.google.android.apps.speech.tts.googletts.settings.asr.voiceime.VoiceInputMethodService")
elif "settings get secure default_input_method" in cmd:
    if _read(IME_FILE) == "set":
        print(COMPONENT)
    else:
        print("com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME")
elif "wm size" in cmd:
    print("Physical size: 1080x2400")
elif "pm path" in cmd:
    # Absent package on a real device: exit 1, no output.
    sys.exit(1)
elif "getprop persist.sys.timezone" in cmd:
    print("Asia/Kolkata")
elif "getprop ro.product.locale" in cmd:
    print("en-US")
elif "am start" in cmd:
    _run_shell_segment(cmd)
elif "install" in cmd and "pull" not in cmd:
    if os.environ.get("FAKE_ADB_INSTALL_FAIL"):
        sys.exit(1)
elif "dumpsys package" in cmd and "personaspeak" in cmd:
    print("versionName=1.13.1")
    print("versionCode=1")
    print("signatures=PackageSignatures{c441f2a version:2, signatures:[847f3baa], past signatures:[]}")
elif "wait-for-device" in cmd:
    pass
elif "uiautomator dump" in cmd:
    pass
elif "screencap" in cmd:
    pass
elif "screenrecord" in cmd:
    pass
elif cmd.startswith("shell ") or (
        "shell" in sys.argv
        and any(t in cmd for t in ("ime enable", "ime set", "dumpsys ",
                                   "input tap", "input keyevent"))):
    # Compound shell payloads (e.g. rewrite + cancel on one transport)
    # execute segment by segment, left to right. Single-purpose shells
    # reach the same segment runner.
    argv = sys.argv[sys.argv.index("shell") + 1:]
    payload = " ".join(argv)
    for segment in payload.replace("&&", ";").split(";"):
        if segment.strip():
            _run_shell_segment(segment.strip())
elif "emu snapshot load" in cmd:
    if os.environ.get("FAKE_ADB_RESTORE_FAIL"):
        sys.exit(2)
    if not os.environ.get("FAKE_ADB_RESTORE_NORESET"):
        _reset_to_pristine()
    if _wm_flag:
        _write(_wm_flag, "1")
elif "emu kill" in cmd:
    pass
elif "pull" in sys.argv:
    idx = sys.argv.index("pull")
    src = sys.argv[idx + 1]
    dest = sys.argv[idx + 2]
    if os.environ.get("FAKE_ADB_EXTRA_ARTIFACT"):
        # Hostile tool: drops an unlisted file into the artifacts dir.
        _artifacts = os.path.dirname(os.path.abspath(dest))
        with open(os.path.join(_artifacts, "hostile-extra.bin"), "wb") as f:
            f.write(b"unexpected")
    if os.environ.get("FAKE_ADB_ESCAPE"):
        # Hostile tool: writes outside the artifacts dir entirely.
        _run_dir = os.path.dirname(os.path.dirname(os.path.abspath(dest)))
        with open(os.path.join(_run_dir, "hostile-write.bin"), "wb") as f:
            f.write(b"escaped")
    if dest.endswith(".png"):
        if os.environ.get("FAKE_ADB_BAD_PNG"):
            with open(dest, "wb") as f:
                f.write(b"\x89PNG\r\n\x1a\nNOT-A-REAL-CHUNK")
        elif os.path.isfile(src):
            import shutil
            shutil.copy2(src, dest)
        else:
            _write_png(dest)
    elif dest.endswith(".mp4"):
        if os.environ.get("FAKE_ADB_BAD_MP4"):
            with open(dest, "wb") as f:
                f.write(b"not-an-mp4-at-all")
        else:
            _write_mp4(dest)
    elif "window_dump.xml" in src:
        if os.environ.get("FAKE_ADB_PULL_SILENT"):
            # Hostile tool: pull reports success and writes nothing.
            pass
        else:
            _write_hierarchy(
                dest,
                duplicate_res_id=os.environ.get("FAKE_ADB_DUPLICATE", ""),
                malformed=bool(os.environ.get("FAKE_ADB_BAD_XML")),
                symlinked=bool(os.environ.get("FAKE_ADB_SYMLINK_XML")),
            )
elif "version" in cmd or "-version" in cmd or "--version" in cmd:
    print("Android Debug Bridge version 1.0.41")

sys.exit(0)
