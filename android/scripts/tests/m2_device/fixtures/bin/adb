#!/usr/bin/env python3
"""Fake adb for device-free M2 harness qualification tests."""
import os
import struct
import sys
import zlib

log_path = os.environ.get("MOCK_COMMANDS_LOG")
if log_path:
    with open(log_path, "a") as f:
        f.write(f"adb: {' '.join(sys.argv[1:])}\n")

STATE_FILE = os.environ.get("FAKE_ADB_STATE", "/tmp/fake_adb_edittext.state")
KB_FILE = os.environ.get("FAKE_ADB_KEYBOARD", "/tmp/fake_adb_keyboard.state")
CANDIDATE = os.environ.get("FAKE_ADB_REPHRASING", "")
SOURCE = "Tea at six."
STALE = "Tea at seven."

APPLY_BOUNDS = (100, 2300, 500, 2380)
CANCEL_BOUNDS = (580, 2300, 980, 2380)
CLEAR_BOUNDS = (950, 200, 1020, 270)
KEY_TAP_BOUNDS = [
    ("t", 430, 1330, 520, 1420), ("e", 240, 1330, 330, 1420),
    ("a", 55, 1430, 145, 1520), ("s", 150, 1430, 240, 1520),
    ("i", 715, 1330, 805, 1420), ("x", 200, 1530, 290, 1620),
    ("v", 390, 1530, 480, 1620), ("n", 580, 1530, 670, 1620),
    (" ", 345, 1630, 675, 1720), (".", 685, 1630, 775, 1720),
]
KB_VIEW = (
    '<node resource-id="biz.pixelperfectstudios.personaspeak:id/keyboard_view" '
    'class="android.widget.FrameLayout" bounds="[0,1300][1080,2400]"/>'
)


def _read(path):
    try:
        with open(path) as f:
            return f.read().rstrip('\n')
    except FileNotFoundError:
        return ""


def _write(path, s):
    with open(path, "w") as f:
        f.write(s)


def _write_png(path):
    sig = b'\x89PNG\r\n\x1a\n'
    ihdr_data = struct.pack('>IIBBBBB', 1, 1, 8, 2, 0, 0, 0)
    ihdr = (
        struct.pack('>I', 13) + b'IHDR' + ihdr_data
        + struct.pack('>I', zlib.crc32(b'IHDR' + ihdr_data) & 0xFFFFFFFF)
    )
    comp = zlib.compress(b'\x00\xff\x00\x00')
    idat = (
        struct.pack('>I', len(comp)) + b'IDAT' + comp
        + struct.pack('>I', zlib.crc32(b'IDAT' + comp) & 0xFFFFFFFF)
    )
    iend = (
        struct.pack('>I', 0) + b'IEND'
        + struct.pack('>I', zlib.crc32(b'IEND') & 0xFFFFFFFF)
    )
    with open(path, 'wb') as f:
        f.write(sig + ihdr + idat + iend)


def _write_mp4(path):
    payload = b'isom' + b'\x00\x00\x00\x00' + b'isom'
    ftyp = struct.pack('>I', 8 + len(payload)) + b'ftyp' + payload
    mdat = struct.pack('>I', 12) + b'mdat' + b'\x00\x00\x00\x00'
    with open(path, 'wb') as f:
        f.write(ftyp + mdat)


def _write_hierarchy(path):
    text = _read(STATE_FILE)
    kb = _read(KB_FILE)
    nodes = KB_VIEW
    if text:
        nodes += (
            '<node resource-id="com.android.settings:id/search_close_btn" '
            'content-desc="Clear" class="android.widget.ImageView" '
            'bounds="[950,200][1020,270]"/>'
        )
    if kb == "LOADING":
        nodes += (
            '<node text="LOADING" resource-id="biz.pixelperfectstudios.personaspeak:id/panel_state" '
            'class="android.widget.TextView" bounds="[10,1810][1070,1850]"/>'
            '<node resource-id="biz.pixelperfectstudios.personaspeak:id/cancel_button" '
            'content-desc="Cancel" class="android.widget.Button" bounds="[580,2300][980,2380]"/>'
        )
    elif kb == "REVIEW":
        nodes += (
            f'<node text="REVIEW" resource-id="biz.pixelperfectstudios.personaspeak:id/panel_state" '
            'class="android.widget.TextView" bounds="[10,1810][1070,1850]"/>'
            f'<node text="{CANDIDATE}" resource-id="biz.pixelperfectstudios.personaspeak:id/candidate_text" '
            'class="android.widget.TextView" bounds="[10,1850][1070,1900]"/>'
            '<node resource-id="biz.pixelperfectstudios.personaspeak:id/apply_button" '
            'content-desc="Apply" class="android.widget.Button" bounds="[100,2300][500,2380]"/>'
            '<node resource-id="biz.pixelperfectstudios.personaspeak:id/cancel_button" '
            'content-desc="Cancel" class="android.widget.Button" bounds="[580,2300][980,2380]"/>'
        )
    with open(path, "w") as f:
        f.write(
            '<hierarchy rotation="0">'
            f'<node index="0" text="{text}" '
            'resource-id="com.android.settings:id/search_action_bar" '
            'class="android.widget.EditText" bounds="[100,200][900,300]"/>'
            f'{nodes}'
            '</hierarchy>'
        )


cmd = " ".join(sys.argv[1:])

if "getprop sys.boot_completed" in cmd:
    print("1")
elif "getprop ro.build.fingerprint" in cmd:
    print("google/sdk_gphone64_arm64/emu64a:14/UE1A.230829.050/12077443:userdebug/dev-keys")
elif "getprop ro.build.version.sdk" in cmd:
    print("34")
elif "getprop ro.product.cpu.abi" in cmd:
    print("arm64-v8a")
elif "getprop ro.sf.lcd_density" in cmd:
    print("420")
elif "settings get global window_animation_scale" in cmd:
    print("1.0")
elif "settings get global transition_animation_scale" in cmd:
    print("1.0")
elif "settings get secure default_input_method" in cmd:
    print("com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME")
elif "wm size" in cmd:
    print("Physical size: 1080x2400")
elif "pm path" in cmd:
    pass
elif "settings get secure enabled_input_methods" in cmd:
    print("com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME:com.google.android.inputmethod.latin/com.google.android.apps.inputmethod.latin.MockVoiceIME")
elif "settings get secure default_input_method" in cmd:
    print("com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME")
elif "getprop persist.sys.timezone" in cmd:
    print("Asia/Kolkata")
elif "getprop ro.product.locale" in cmd:
    print("en-US")
elif "am start" in cmd:
    pass
elif "install" in cmd and "pull" not in cmd:
    if os.environ.get("FAKE_ADB_INSTALL_FAIL"):
        sys.exit(1)
elif "dumpsys package" in cmd and "personaspeak" in cmd:
    print("versionName=0.1.0")
    print("versionCode=1")
    print("signatures=[Signature [a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2]]")
elif "wait-for-device" in cmd:
    pass
elif "uiautomator dump" in cmd:
    pass
elif "screencap" in cmd:
    pass
elif "screenrecord" in cmd:
    pass
elif "input tap" in cmd:
    parts = sys.argv
    x_idx = parts.index("tap") + 1
    x, y = int(parts[x_idx]), int(parts[x_idx + 1])
    for char, bx1, by1, bx2, by2 in KEY_TAP_BOUNDS:
        if bx1 <= x <= bx2 and by1 <= y <= by2:
            cur = _read(STATE_FILE)
            if not cur and char.isalpha():
                cur = char.upper()
            else:
                cur += char
            _write(STATE_FILE, cur)
            if cur == SOURCE and not _read(KB_FILE):
                _write(KB_FILE, "LOADING")
            break
    else:
        cx1, cy1, cx2, cy2 = CLEAR_BOUNDS
        if cx1 <= x <= cx2 and cy1 <= y <= cy2:
            _write(STATE_FILE, "")
        else:
            kb = _read(KB_FILE)
            if kb == "REVIEW":
                ax1, ay1, ax2, ay2 = APPLY_BOUNDS
                cx1b, cy1b, cx2b, cy2b = CANCEL_BOUNDS
                if ax1 <= x <= ax2 and ay1 <= y <= ay2:
                    cur = _read(STATE_FILE)
                    if cur == SOURCE:
                        _write(STATE_FILE, CANDIDATE)
                    _write(KB_FILE, "")
                elif cx1b <= x <= cx2b and cy1b <= y <= cy2b:
                    _write(KB_FILE, "")
elif "input keyevent" in cmd:
    cur = _read(STATE_FILE)
    _write(STATE_FILE, cur[:-1])
elif "emu snapshot load" in cmd:
    pass
elif "emu kill" in cmd:
    pass
elif "pull" in sys.argv:
    idx = sys.argv.index("pull")
    src = sys.argv[idx + 1]
    dest = sys.argv[idx + 2]
    if dest.endswith(".png"):
        if os.path.isfile(src):
            import shutil
            shutil.copy2(src, dest)
        else:
            _write_png(dest)
    elif dest.endswith(".mp4"):
        _write_mp4(dest)
    elif "window_dump.xml" in src:
        _write_hierarchy(dest)
        if _read(KB_FILE) == "LOADING":
            _write(KB_FILE, "REVIEW")
elif "version" in cmd or "-version" in cmd or "--version" in cmd:
    print("Android Debug Bridge version 1.0.41")

sys.exit(0)
